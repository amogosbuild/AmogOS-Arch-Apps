<?xml version="1.0" encoding="UTF-8"?>
<!-- Limit the first-boot authorization to the account handoff helper. -->
<policyconfig>
  <action id="amogosarch.onboarding.finish">
    <description>Finish AmogOS Arch setup</description>
    <message>Complete first-boot account setup</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/amogos-arch-onboarding/finish</annotate>
  </action>
</policyconfig>
