#!/usr/bin/python3
import configparser
import json
import os
import pathlib
import random
import subprocess
import time

home=pathlib.Path.home()
config=home/'.config'
defaults=pathlib.Path('/usr/share/amogos-arch')
wallpapers=pathlib.Path('/usr/share/wallpapers/AmogOSArch')
desktop=os.environ.get('XDG_CURRENT_DESKTOP','').upper()
preferences=config/'amogos-arch/session.json'
settings=json.loads(preferences.read_text()) if preferences.is_file() else {}
dark=settings.get('theme','dark')=='dark'
marker=config/'amogos-arch'/(desktop.replace(':','-')+'.initialized')


def run(*args):
    return subprocess.run(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False,timeout=20).returncode==0


def gset(schema,key,value):
    run('gsettings','set',schema,key,value)


def ini(path,values):
    parser=configparser.ConfigParser(interpolation=None)
    parser.optionxform=str
    parser.read(path)
    for section,items in values.items():
        if section not in parser:
            parser.add_section(section)
        parser[section].update(items)
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('w') as output:
        parser.write(output,space_around_delimiters=False)


def kde():
    if not marker.exists():
        scheme='BreezeDark' if dark else 'BreezeLight'
        run('plasma-apply-colorscheme',scheme)
        if settings.get('largerText'):
            run('kwriteconfig6','--file','kdeglobals','--group','General','--key','font','Noto Sans,13,-1,5,400,0,0,0,0,0')
    wallpaper=random.choice(sorted(wallpapers.glob('*.png')))
    for attempt in range(12):
        if run('plasma-apply-wallpaperimage',str(wallpaper)):
            return True
        time.sleep(1)
    return False


def gnome():
    wallpaper=random.choice(sorted(wallpapers.glob('*.png'))).as_uri()
    gset('org.gnome.desktop.background','picture-uri',wallpaper)
    gset('org.gnome.desktop.background','picture-uri-dark',wallpaper)
    if not marker.exists():
        gset('org.gnome.desktop.interface','color-scheme','prefer-dark' if dark else 'prefer-light')
        gset('org.gnome.desktop.interface','accent-color','teal')
        gset('org.gnome.desktop.interface','text-scaling-factor','1.25' if settings.get('largerText') else '1.0')
        gset('org.gnome.desktop.a11y.interface','high-contrast','true' if settings.get('highContrast') else 'false')
        gset('org.gnome.shell','favorite-apps',"['org.gnome.Nautilus.desktop','firefox.desktop','amogosarch.appstore.desktop','steam.desktop','amogosarch.steam-big-picture.desktop']")
    gset('org.gnome.shell','disable-user-extensions','false')
    gset('org.gnome.shell','enabled-extensions',"['dash-to-dock@micxgx.gmail.com']")
    dock='/usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com/schemas'
    for key,value in {'dock-position':'BOTTOM','dock-fixed':'true','autohide':'false','intellihide':'false','extend-height':'false','dash-max-icon-size':'48','show-trash':'false'}.items():
        run('gsettings','--schemadir',dock,'set','org.gnome.shell.extensions.dash-to-dock',key,value)
    return True


def lxqt():
    wallpaper=wallpapers/('5.png' if dark else '6.png')
    if not marker.exists():
        panel=config/'lxqt/panel.conf'
        panel.parent.mkdir(parents=True,exist_ok=True)
        if not panel.exists():
            panel.write_bytes((defaults/'lxqt/panel.conf').read_bytes())
        ini(config/'lxqt/lxqt.conf',{'General':{'icon_theme':'Papirus-Dark' if dark else 'Papirus','theme':'Breeze'}})
        ini(config/'pcmanfm-qt/lxqt/settings.conf',{'Desktop':{'Wallpaper':str(wallpaper),'WallpaperMode':'zoom'}})
        ini(config/'gtk-3.0/settings.ini',{'Settings':{'gtk-icon-theme-name':'Papirus-Dark' if dark else 'Papirus'}})
        launchers=config/'plank/dock1/launchers'
        launchers.mkdir(parents=True,exist_ok=True)
        for index,entry in enumerate(('pcmanfm-qt.desktop','firefox.desktop','amogosarch.appstore.desktop','steam.desktop','amogosarch.steam-big-picture.desktop')):
            (launchers/f'{index}.dockitem').write_text(f'[PlankDockItemPreferences]\nLauncher=file:///usr/share/applications/{entry}\n')
        gset('net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/','theme','AmogOS')
        gset('net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/','hide-mode','none')
        gset('net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/','icon-size','48')
        run('pcmanfm-qt','--set-wallpaper',str(wallpaper))
    subprocess.Popen(['picom','--backend','xrender'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    subprocess.Popen(['plank'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    return True


handler=kde if 'KDE' in desktop else gnome if 'GNOME' in desktop else lxqt if 'LXQT' in desktop else None
if handler and os.getuid()!=0 and handler():
    marker.parent.mkdir(parents=True,exist_ok=True)
    marker.touch()
