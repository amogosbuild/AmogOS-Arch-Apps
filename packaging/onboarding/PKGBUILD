# Install the Flutter onboarding app and its narrowly scoped privileged handoff.
pkgname=amogos-arch-onboarding
pkgver=0.1.0
pkgrel=4
pkgdesc='First-boot account and desktop setup for AmogOS Arch'
arch=(x86_64)
url='https://github.com/amogosbuild/AmogOS-Arch-Apps'
license=(custom)
options=(!strip !debug)
depends=(gtk3 libglvnd python polkit systemd shadow procps-ng sddm)

package() {
    local project="$AMOGOS_APPS_ROOT/onboarding"
    local destination="$pkgdir/usr/lib/$pkgname"
    install -d "$destination/app"
    cp -a "$project/build/linux/x64/release/bundle/." "$destination/app/"
    install -m755 "$project/backend/"{prepare,finish,cleanup,start} "$destination/"
    install -m644 "$project/backend/state.py" "$destination/state.py"
    install -Dm644 "$project/packaging/systemd/$pkgname-finish.service" "$pkgdir/usr/lib/systemd/system/$pkgname-finish.service"
    install -Dm644 "$project/packaging/polkit/amogosarch.onboarding.policy" "$pkgdir/usr/share/polkit-1/actions/amogosarch.onboarding.policy"
    install -Dm644 "$project/packaging/polkit/50-amogos-arch-onboarding.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-amogos-arch-onboarding.rules"
    install -Dm644 "$project/packaging/autostart/$pkgname.desktop" "$pkgdir/etc/xdg/autostart/$pkgname.desktop"
    install -Dm644 "$AMOGOS_APPS_ROOT/ARTWORK-LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/ARTWORK-LICENSE.md"
}
