# Install the Arch Store bundle with the bounded Pacman helper and desktop launchers.
pkgname=amogos-arch-store
pkgver=0.1.0
pkgrel=2
pkgdesc='AmogOS Arch App Store for Pacman, AUR, Flatpak and AppImage'
arch=(x86_64)
url='https://github.com/amogosbuild/AmogOS-Arch-Apps'
license=(custom)
options=(!strip !debug)
depends=(gtk3 libglvnd python python-gobject acl pacman polkit systemd xdg-utils zenity fuse2)
optdepends=('flatpak: Flathub applications' 'git: AUR package recipes' 'base-devel: AUR builds')

package() {
    local project="$AMOGOS_APPS_ROOT/amogos-store"
    install -d "$pkgdir/usr/lib/$pkgname/"{app,backend} "$pkgdir/usr/share/licenses/$pkgname"
    cp -a "$project/build/linux/x64/release/bundle/." "$pkgdir/usr/lib/$pkgname/app/"
    install -m644 "$project/backend/"{cli,transaction_worker}.py "$pkgdir/usr/lib/$pkgname/backend/"
    install -d "$pkgdir/usr/lib/$pkgname/backend/amogos_store"
    install -m644 "$project/backend/amogos_store/"*.py "$pkgdir/usr/lib/$pkgname/backend/amogos_store/"
    install -Dm755 "$project/packaging/amogos-arch-appstore" "$pkgdir/usr/bin/amogos-arch-appstore"
    install -Dm755 "$project/packaging/amogos-arch-appimage-open" "$pkgdir/usr/libexec/amogos-arch-appimage-open"
    install -Dm755 "$project/packaging/amogos-arch-makepkg-pacman" "$pkgdir/usr/libexec/amogos-arch-makepkg-pacman"
    install -Dm644 "$project/packaging/aur-pacman.conf" "$pkgdir/usr/share/$pkgname/aur-pacman.conf"
    install -Dm755 "$project/packaging/$pkgname-helper" "$pkgdir/usr/libexec/$pkgname-helper"
    install -Dm644 "$project/packaging/amogosarch.appstore.desktop" "$pkgdir/usr/share/applications/amogosarch.appstore.desktop"
    install -Dm644 "$project/packaging/amogosarch.appstore.policy" "$pkgdir/usr/share/polkit-1/actions/amogosarch.appstore.policy"
    install -Dm644 "$AMOGOS_APPS_ROOT/system/rootfs/usr/share/pixmaps/amogos-menu.png" "$pkgdir/usr/share/pixmaps/amogosarch.appstore.png"
    cp -a "$project/third_party/." "$pkgdir/usr/share/licenses/$pkgname/"
    install -m644 "$AMOGOS_APPS_ROOT/ARTWORK-LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/ARTWORK-LICENSE.md"
}
